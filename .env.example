# Copy to ".env" in this folder and fill in values. Never commit ".env" (it is gitignored).

# -- LLM keys (at least one required) --
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# -- Premium models (Claude) --
# With ANTHROPIC_API_KEY set, Orynn auto-selects Claude for every mode and the
# Effort slider controls real reasoning depth (low/medium/high/max).
# Which Claude model to use (default claude-opus-5-5). Others:
# claude-fable-5-2 (most capable, pricier), claude-sonnet-5-5, claude-haiku-5-5.
ANTHROPIC_MODEL=
# Set to 1 to keep the free models as the default even with an Anthropic key
# (Claude stays selectable in the model picker).
PREFER_FREE_MODELS=

# -- API / session --
AGENT_API_KEY=
ORYNN_API_KEY=
ORYNN_PORT=
ORYNN_WORKSPACE=
SESSION_TTL_SECONDS=
SESSION_COOKIE_SECURE=
# Keep empty unless you intentionally expose the dashboard beyond localhost.
ORYNN_ALLOW_REMOTE_SESSION=

# -- CORS --
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# -- Agent tuning (optional) --
APPROVAL_WAIT_TIMEOUT_SECONDS=
PERMISSION_WAIT_TIMEOUT_SECONDS=
ORYNN_MAX_ACTIVE_TASKS=
ORYNN_MAX_PERSISTED_TASKS=
AGENT_MAX_STEPS=
BROWSER_MAX_STEPS=
DESKTOP_MAX_STEPS=
# Step caps above default to 25 / 35 / 40 on free models and 60 / 80 / 100 on
# strong models (current Claude). A value set here wins for every model.
# Token budget per task: 100000 on free models, 2000000 on strong models.
ORYNN_TOKEN_BUDGET=
# Force the loop tuning: "strong" (e.g. a top model on OpenRouter) or "default".
ORYNN_LOOP_PROFILE=
# Desktop control defaults to the FREE UIA tier. For rock-solid reliability on
# long multi-step desktop tasks (chained actions, big forms), opt in to a
# stronger model here - free stays the default if left blank. Examples:
#   DESKTOP_MODEL=claude-opus-5-5                   (needs ANTHROPIC_API_KEY)
#   DESKTOP_MODEL=gpt-4o                              (needs OPENAI_API_KEY)
#   DESKTOP_MODEL=openrouter/openai/gpt-oss-120b:free (still free, just bigger)
DESKTOP_MODEL=

# -- Browser / memory --
# BROWSER_HEADED=1
# USE_CHROMA=1

# -- Discord (pip install discord.py; Message Content Intent in portal) --
# Remote integrations are disabled unless at least one allowlist is set.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_GUILD_IDS=

# -- Telegram (pip install python-telegram-bot) --
# Remote integrations are disabled unless at least one allowlist is set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# -- Optional MCP-related keys --
EXA_API_KEY=
FIGMA_ACCESS_TOKEN=
TAVILY_API_KEY=
SLACK_BOT_TOKEN=
ORYNN_MCP_CONFIG=

# Legacy AI_COMPUTER_* variables are still accepted for existing local installs.
